function renderCardForm(){
  var cd = checkoutState.cardData || {};
  var brandTop = cd.brand ? cd.brand.toUpperCase() : 'CARD';
  return '<div class="card-form"><div class="card-visual"><div class="card-brand-top">'+brandTop+'</div><div class="card-chip"></div><div class="card-num-vis" id="cardNumVis">'+formatCardDisplay(cd.number || '')+'</div><div class="card-bottom"><div><div class="card-lbl">Card Holder</div><div class="card-val" id="cardNameVis">'+((cd.name || 'YOUR NAME').toUpperCase())+'</div></div><div style="text-align:right"><div class="card-lbl">Expires</div><div class="card-val" id="cardExpVis">'+(cd.exp||'MM/YY')+'</div></div></div></div><div class="card-fields"><div class="full"><label class="card-label">Card number</label><input class="card-input" id="cfNumber" inputmode="numeric" placeholder="1234 5678 9012 3456" maxlength="19"></div><div class="full"><label class="card-label">Name on card</label><input class="card-input" id="cfName" placeholder="JANE DOE" autocomplete="cc-name"></div><div><label class="card-label">Expiry</label><input class="card-input" id="cfExp" placeholder="MM/YY" maxlength="5" inputmode="numeric"></div><div><label class="card-label">CVV</label><input class="card-input" id="cfCvv" placeholder="•••" maxlength="4" inputmode="numeric" type="password"></div></div></div>';
}
function formatCardDisplay(num){
  var digits = num.replace(/\D/g,'').slice(0,16);
  var groups = digits.match(/.{1,4}/g) || [];
  while(groups.length < 4) groups.push('••••');
  return groups.join(' ');
}
function bindCardForm(){
  var num = $('#cfNumber'), name = $('#cfName'), exp = $('#cfExp'), cvv = $('#cfCvv');
  if(!num) return;
  num.addEventListener('input', function(e){
    var v = e.target.value.replace(/\D/g,'').slice(0,16);
    e.target.value = v.replace(/(.{4})/g,'$1 ').trim();
    checkoutState.cardData.number = v;
    checkoutState.cardData.brand = detectBrand(v);
    checkoutState.cardData.last4 = v.slice(-4);
    var vis = $('#cardNumVis'); if(vis) vis.textContent = formatCardDisplay(v);
    var bt = document.querySelector('.card-brand-top'); if(bt) bt.textContent = (checkoutState.cardData.brand || 'CARD').toUpperCase();
  });
  if(name) name.addEventListener('input', function(e){
    checkoutState.cardData.name = e.target.value;
    var vis = $('#cardNameVis'); if(vis) vis.textContent = (e.target.value || 'YOUR NAME').toUpperCase();
  });
  if(exp) exp.addEventListener('input', function(e){
    var v = e.target.value.replace(/\D/g,'').slice(0,4);
    if(v.length >= 3) v = v.slice(0,2) + '/' + v.slice(2);
    e.target.value = v;
    checkoutState.cardData.exp = v;
    var vis = $('#cardExpVis'); if(vis) vis.textContent = v || 'MM/YY';
  });
  if(cvv) cvv.addEventListener('input', function(e){
    e.target.value = e.target.value.replace(/\D/g,'').slice(0,4);
    checkoutState.cardData.cvv = e.target.value;
  });
}
function detectBrand(num){
  if(/^4/.test(num)) return 'visa';
  if(/^5[1-5]/.test(num) || /^2[2-7]/.test(num)) return 'mastercard';
  if(/^3[47]/.test(num)) return 'amex';
  if(/^6/.test(num)) return 'discover';
  return null;
}
function getPayMethodName(id){
  var m = getPaymentMethods().find(function(x){ return x.id === id; });
  return m ? m.name : id;
}
function placeOrder(){
  if(checkoutState.methodId === 'card'){
    var cd = checkoutState.cardData;
    if(!cd.number || cd.number.length < 13){ toast('Please enter a valid card number', '', 'error'); return; }
    if(!cd.name || cd.name.length < 2){ toast('Please enter name on card', '', 'error'); return; }
    if(!cd.exp || cd.exp.length !== 5){ toast('Please enter card expiry', '', 'error'); return; }
    if(!cd.cvv || cd.cvv.length < 3){ toast('Please enter CVV', '', 'error'); return; }
  }
  var btn = $('#placeOrderBtn'); if(btn){ btn.classList.add('loading'); btn.disabled = true; }
  setTimeout(function(){
    var subtotalUSD = cart.reduce(function(s,i){ return s + byId(i.id).price * i.qty; }, 0);
    var shipping = subtotalUSD >= 35 ? 0 : 4.99;
    var tax = subtotalUSD * 0.08;
    var total = subtotalUSD + shipping + tax;
    checkoutState.totalUSD = total;
    checkoutState.orderId = 'NX-' + rnd(48300, 48999);
    billingHistory.unshift({
      id: checkoutState.orderId,
      date: new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}),
      method: checkoutState.methodId === 'card' ? ((checkoutState.cardData.brand ? (checkoutState.cardData.brand.charAt(0).toUpperCase() + checkoutState.cardData.brand.slice(1)) : 'Card') + ' •• ' + (checkoutState.cardData.last4 || '4242')) : getPayMethodName(checkoutState.methodId),
      amount: total, status: 'paid'
    });
    sellerPayout.txns.unshift({
      type: 'sale',
      title: cart[0] ? byId(cart[0].id).title : 'Order',
      meta: 'Order ' + checkoutState.orderId + ' · ' + (checkoutState.methodId === 'card' ? 'Card' : getPayMethodName(checkoutState.methodId)),
      amount: total,
      date: new Date().toLocaleDateString('en-US', {month:'short', day:'numeric'})
    });
    cart = [];
    updateCartUI();
    checkoutState.step = 4;
    renderCheckout();
    toast('Order ' + checkoutState.orderId + ' placed successfully!');
  }, 1400);
}

