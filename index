  if(e.target.closest('[data-close-auth]')){ closeAuth(); return; }
  if(e.target.closest('[data-close-dash]')){ closeDashboard(); return; }
  if(e.target.closest('[data-close-checkout]')){ closeCheckout(); return; }
  if(e.target.closest('[data-close-paymanage]')){ closePayManage(); return; }
  var authLink = e.target.closest('[data-open-auth]');
  if(authLink){ e.preventDefault(); openAuth(authLink.dataset.openAuth); return; }
  var openDash = e.target.closest('[data-open-dash]');
  if(openDash && currentUser){ e.preventDefault(); closeAccountMenu(); openDashboard(); return; }
  var pm = e.target.closest('[data-open-paymanage]');
  if(pm){ e.preventDefault(); closeAccountMenu(); openPayManage(); return; }
  var countryItem = e.target.closest('[data-country]');
  if(countryItem){ setCountry(countryItem.dataset.country); return; }
  var addr = e.target.closest('[data-addr]');
  if(addr){ checkoutState.addressId = addr.dataset.addr; renderCheckout(); return; }
  var method = e.target.closest('[data-method]');
  if(method){ checkoutState.methodId = method.dataset.method; renderCheckout(); return; }
});

