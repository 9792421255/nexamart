<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexaMart — Premium Online Shopping</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#0a0e14;--ink-2:#4a5568;--ink-3:#8896a8;
  --navy:#0b1622;--navy-2:#13202f;--navy-3:#1e2d3d;
  --line:#e6eaef;--line-2:#f1f4f8;--bg:#f6f7f9;
  --card:#ffffff;--surface:#fbfcfd;
  --orange:#ff8a00;--orange-d:#e67a00;--orange-l:#ffb84d;
  --amber:#ffc978;--amber-h:#ffb84d;--gold:#d4a85a;
  --link:#0066c0;--link-h:#c45500;
  --green:#067a5c;--red:#c0392b;--star:#ffa41c;
  --purple:#7c3aed;--teal:#0891b2;
  --sh-xs:0 1px 2px rgba(11,22,34,.04);
  --sh-sm:0 2px 6px rgba(11,22,34,.06),0 1px 2px rgba(11,22,34,.04);
  --sh-md:0 6px 20px rgba(11,22,34,.08),0 2px 6px rgba(11,22,34,.05);
  --sh-lg:0 20px 50px rgba(11,22,34,.14),0 6px 18px rgba(11,22,34,.08);
  --sh-xl:0 32px 80px rgba(11,22,34,.22);
  --r-sm:6px;--r:10px;--r-lg:16px;--r-xl:22px;
  --maxw:1480px;
  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --ease:cubic-bezier(.22,1,.36,1);
}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--font);background:var(--bg);color:var(--ink);font-size:14.5px;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden;letter-spacing:-.006em}
img{display:block;max-width:100%;height:auto}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit;font-family:inherit}
input,select,textarea{font:inherit;font-family:inherit}
a{color:inherit;text-decoration:none}
::selection{background:var(--orange);color:#fff}
*{-webkit-tap-highlight-color:transparent}
*::-webkit-scrollbar{width:11px;height:11px}
*::-webkit-scrollbar-track{background:transparent}
*::-webkit-scrollbar-thumb{background:#c8d0d9;border-radius:20px;border:3px solid transparent;background-clip:padding-box}
*::-webkit-scrollbar-thumb:hover{background:#9aa5b1;background-clip:padding-box;border:3px solid transparent}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

.announce{background:linear-gradient(90deg,#0b1622 0%,#1e2d3d 50%,#0b1622 100%);color:#fff;font-size:12.5px;font-weight:500;padding:9px 24px;text-align:center;letter-spacing:.02em;position:relative;overflow:hidden}
.announce::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,138,0,.14),transparent);animation:shimmer 4s ease-in-out infinite}
@keyframes shimmer{0%,100%{transform:translateX(-100%)}50%{transform:translateX(100%)}}
.announce b{color:var(--amber);font-weight:700}
.announce span{position:relative;z-index:1}

.header{position:sticky;top:0;z-index:200;background:var(--navy);transition:box-shadow .3s var(--ease),background .3s var(--ease)}
.header.scrolled{background:rgba(11,22,34,.88);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);box-shadow:0 4px 24px rgba(0,0,0,.24)}
.header-main{display:flex;align-items:center;gap:6px;max-width:var(--maxw);margin:0 auto;padding:10px 24px;height:70px}
.h-box{display:flex;flex-direction:column;justify-content:center;padding:8px 10px;border-radius:var(--r-sm);border:1px solid transparent;transition:border-color .2s var(--ease),background .2s var(--ease);white-space:nowrap;cursor:pointer;position:relative}
.h-box:hover{border-color:rgba(255,255,255,.35)}
.h-label{font-size:11px;color:rgba(255,255,255,.72);line-height:1.2;font-weight:500}
.h-strong{font-size:13.5px;font-weight:700;line-height:1.25;color:#fff;display:flex;align-items:center;gap:5px;letter-spacing:-.01em}
.chev{width:8px;height:8px;border-right:1.5px solid rgba(255,255,255,.6);border-bottom:1.5px solid rgba(255,255,255,.6);transform:rotate(45deg) translateY(-2px);margin-left:3px;transition:transform .2s}
.country-box{display:flex;align-items:center;gap:8px}
.country-flag{font-size:20px;line-height:1}
.country-info{display:flex;flex-direction:column;justify-content:center}
.country-name{font-size:11px;color:rgba(255,255,255,.72);line-height:1.2;font-weight:500}
.country-curr{font-size:13.5px;font-weight:700;color:#fff;display:flex;align-items:center;gap:5px;letter-spacing:-.01em}
.country-menu{position:absolute;top:calc(100% + 8px);left:0;min-width:320px;max-height:420px;overflow-y:auto;background:#fff;border-radius:var(--r-lg);box-shadow:var(--sh-xl);border:1px solid var(--line);padding:8px;z-index:120;opacity:0;transform:translateY(-8px) scale(.98);pointer-events:none;transition:opacity .22s var(--ease),transform .22s var(--ease)}
.h-box.country.open .country-menu,.h-box.country:hover .country-menu{opacity:1;transform:none;pointer-events:auto}
.country-menu-head{padding:12px 14px 10px;border-bottom:1px solid var(--line-2);margin-bottom:6px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);display:flex;align-items:center;justify-content:space-between}
.country-menu-head span{color:var(--orange-d)}
.country-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:var(--r-sm);cursor:pointer;transition:background .14s;width:100%;text-align:left}
.country-item:hover{background:var(--surface)}
.country-item.active{background:#fff5e6}
.country-item .flag{font-size:22px;line-height:1;flex:0 0 auto;width:30px;text-align:center}
.country-item .info{flex:1;min-width:0}
.country-item .name{font-size:13.5px;font-weight:700;color:var(--ink);letter-spacing:-.01em}
.country-item .meta{font-size:11.5px;color:var(--ink-3);font-weight:500;margin-top:1px}
.country-item .check{width:20px;height:20px;color:var(--orange);opacity:0;transition:opacity .18s;flex:0 0 auto}
.country-item.active .check{opacity:1}
.logo{display:flex;flex-direction:column;padding:6px 8px 4px;border:1px solid transparent;border-radius:var(--r-sm);position:relative;transition:border-color .2s}
.logo:hover{border-color:rgba(255,255,255,.35)}
.logo-text{font-size:26px;font-weight:900;letter-spacing:-1.4px;line-height:1;color:#fff;background:linear-gradient(135deg,#fff 0%,#e6eef7 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.logo-svg{width:86px;height:11px;margin-top:-4px;margin-left:4px}
.search-wrap{position:relative;flex:1 1 auto;display:flex;min-width:140px}
.search{flex:1;display:flex;height:44px;border-radius:var(--r);overflow:hidden;background:#fff;border:2px solid transparent;transition:box-shadow .22s var(--ease);box-shadow:0 1px 3px rgba(0,0,0,.1)}
.search:focus-within{box-shadow:0 0 0 4px rgba(255,138,0,.35),0 4px 12px rgba(0,0,0,.15);border-color:rgba(255,138,0,.5)}
.search-cat{background:#f4f6f8;color:#4a5568;border:none;border-right:1px solid var(--line);padding:0 8px 0 16px;font-size:12.5px;font-weight:600;cursor:pointer;outline:none;transition:background .15s;max-width:160px}
.search-cat:hover{background:#e9edf2}
.search-input{flex:1;border:none;outline:none;padding:0 16px;font-size:15px;color:var(--ink);min-width:0;font-weight:500}
.search-input::placeholder{color:#a0aec0;font-weight:400}
.search-btn{width:56px;background:linear-gradient(135deg,var(--orange) 0%,var(--orange-d) 100%);display:grid;place-items:center;transition:filter .18s,transform .18s}
.search-btn:hover{filter:brightness(1.08)}
.search-btn:active{transform:scale(.96)}
.search-btn svg{width:20px;height:20px;color:#fff}
.suggest{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;color:var(--ink);border-radius:var(--r-lg);box-shadow:var(--sh-lg);overflow:hidden;max-height:440px;overflow-y:auto;display:none;z-index:60;border:1px solid var(--line);animation:sugIn .22s var(--ease) both}
@keyframes sugIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
.suggest.open{display:block}
.sug-item{display:flex;align-items:center;gap:14px;padding:11px 16px;cursor:pointer;border-bottom:1px solid var(--line-2);transition:background .14s}
.sug-item:last-child{border-bottom:none}
.sug-item:hover{background:var(--surface)}
.sug-img{width:44px;height:44px;border-radius:var(--r-sm);overflow:hidden;flex:0 0 auto;background:var(--line-2)}
.sug-img img{width:100%;height:100%;object-fit:cover}
.sug-txt{flex:1;min-width:0}
.sug-title{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sug-cat{font-size:11.5px;color:var(--ink-3);font-weight:500}
.sug-price{font-weight:800;font-size:14px;letter-spacing:-.02em}
.sug-empty{padding:22px;color:var(--ink-3);font-size:13.5px;text-align:center;font-weight:500}
.cart-btn{display:flex;align-items:flex-end;position:relative;padding:8px 10px;border:1px solid transparent;border-radius:var(--r-sm);transition:border-color .2s}
.cart-btn:hover{border-color:rgba(255,255,255,.35)}
.cart-icon{position:relative;display:flex;align-items:center}
.cart-icon svg{width:40px;height:32px;color:#fff}
.cart-count{position:absolute;top:-8px;left:50%;transform:translateX(-50%);color:var(--orange);font-weight:800;font-size:16px;min-width:22px;text-align:center;transition:transform .25s cubic-bezier(.34,1.56,.64,1);letter-spacing:-.03em}
.cart-count.pop{transform:translateX(-50%) scale(1.7)}
.cart-label{font-size:13.5px;font-weight:700;margin-left:2px;color:#fff}
.nav{background:var(--navy-2);color:#fff;display:flex;align-items:center;gap:2px;padding:0 24px;height:44px;overflow-x:auto;overflow-y:hidden}
.nav::-webkit-scrollbar{height:0}
.nav-all{display:flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;padding:8px 12px;border-radius:var(--r-sm);border:1px solid transparent;white-space:nowrap;transition:border-color .18s}
.nav-all:hover{border-color:rgba(255,255,255,.4)}
.burger{width:16px;height:11px;display:flex;flex-direction:column;justify-content:space-between}
.burger span{height:1.8px;background:#fff;border-radius:2px;display:block}
.nav a{padding:8px 12px;border-radius:var(--r-sm);border:1px solid transparent;font-size:13.5px;font-weight:500;white-space:nowrap;transition:border-color .18s,background .18s;color:rgba(255,255,255,.92)}
.nav a:hover{border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.04)}
.nav .spacer{flex:1}
.nav .promo{font-weight:600;color:var(--amber);white-space:nowrap;padding-right:8px;font-size:13px;display:flex;align-items:center;gap:8px}
.nav .promo::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 4px rgba(255,201,120,.2);animation:pulse 1.8s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.85)}}

.acct-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:280px;background:#fff;border-radius:var(--r-lg);box-shadow:var(--sh-xl);border:1px solid var(--line);padding:8px;z-index:120;opacity:0;transform:translateY(-8px) scale(.98);pointer-events:none;transition:opacity .22s var(--ease),transform .22s var(--ease)}
.h-box.account.open .acct-menu,.h-box.account:hover .acct-menu{opacity:1;transform:none;pointer-events:auto}
.acct-header{padding:16px;border-bottom:1px solid var(--line-2);margin-bottom:6px;display:flex;align-items:center;gap:12px}
.acct-avatar{width:44px;height:44px;border-radius:50%;flex:0 0 auto;background:linear-gradient(135deg,var(--orange),var(--amber));display:grid;place-items:center;color:#1a1204;font-weight:800;font-size:16px;box-shadow:0 4px 12px rgba(255,138,0,.3)}
.acct-avatar.admin{background:linear-gradient(135deg,#7c3aed,#a78bfa);color:#fff;box-shadow:0 4px 12px rgba(124,58,237,.3)}
.acct-avatar.seller{background:linear-gradient(135deg,#0891b2,#22d3ee);color:#fff;box-shadow:0 4px 12px rgba(8,145,178,.3)}
.acct-info{flex:1;min-width:0}
.acct-name{font-size:14px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.acct-role{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:99px;margin-top:3px}
.acct-role.customer{background:#fff5e6;color:#b86000}
.acct-role.seller{background:#e0f7fa;color:#067a9e}
.acct-role.admin{background:#f3e8ff;color:#6b21a8}
.acct-menu a,.acct-menu button.menu-item{display:flex;align-items:center;gap:11px;width:100%;text-align:left;padding:10px 12px;border-radius:var(--r-sm);font-size:13.5px;font-weight:600;color:var(--ink);transition:background .16s;cursor:pointer}
.acct-menu a:hover,.acct-menu button.menu-item:hover{background:var(--surface)}
.acct-menu svg{width:16px;height:16px;color:var(--ink-3);flex:0 0 auto}
.acct-divider{height:1px;background:var(--line-2);margin:6px 0}
.menu-badge{margin-left:auto;font-size:10px;font-weight:800;color:#fff;background:var(--red);padding:2px 7px;border-radius:99px;letter-spacing:.04em}
.auth-btn{display:flex;align-items:center;gap:7px;background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);color:#1a1204;font-size:13px;font-weight:800;padding:8px 16px;border-radius:99px;box-shadow:0 3px 10px rgba(255,138,0,.28);transition:transform .18s var(--ease),box-shadow .18s;letter-spacing:-.01em;white-space:nowrap}
.auth-btn:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(255,138,0,.42)}
.auth-btn svg{width:14px;height:14px}

.hero{position:relative;height:620px;overflow:hidden;background:var(--navy)}
.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.1s var(--ease);display:flex;align-items:flex-start}
.hero-slide.active{opacity:1}
.hero-inner{max-width:var(--maxw);margin:0 auto;width:100%;padding:70px 24px 0;display:flex;align-items:center;justify-content:space-between;gap:40px}
.hero-copy{max-width:600px}
.hero-slide.active .hero-copy{animation:heroIn 1s var(--ease) both}
@keyframes heroIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.hero-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.14);backdrop-filter:blur(12px);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:8px 16px;border-radius:99px;margin-bottom:22px;border:1px solid rgba(255,255,255,.22)}
.hero-tag::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--amber);box-shadow:0 0 12px var(--amber)}
.hero-title{font-size:clamp(36px,5vw,68px);font-weight:900;line-height:1.02;letter-spacing:-.045em;color:#fff;margin-bottom:18px;text-shadow:0 2px 24px rgba(0,0,0,.2)}
.hero-title em{font-style:normal;color:var(--amber)}
.hero-sub{font-size:clamp(15px,1.5vw,19px);color:rgba(255,255,255,.85);margin-bottom:34px;max-width:480px;line-height:1.55}
.hero-cta{display:inline-flex;align-items:center;gap:10px;background:#fff;color:var(--navy);font-weight:800;font-size:14.5px;padding:15px 32px;border-radius:99px;box-shadow:0 10px 32px rgba(0,0,0,.22);transition:transform .25s var(--ease),box-shadow .25s var(--ease);letter-spacing:-.01em}
.hero-cta:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(0,0,0,.3)}
.hero-cta svg{transition:transform .25s var(--ease)}
.hero-cta:hover svg{transform:translateX(3px)}
.hero-cta.gold{background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);color:#1a1204}
.hero-art{position:relative;flex:0 0 auto}
.hero-art-inner{width:clamp(280px,32vw,480px);height:clamp(280px,32vw,480px);border-radius:32px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.08);animation:float 6s ease-in-out infinite}
.hero-art-inner img{width:100%;height:100%;object-fit:cover}
@keyframes float{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(-24px) rotate(1.5deg)}}
.hero-art-badge{position:absolute;bottom:-16px;left:-16px;background:#fff;color:var(--ink);padding:14px 22px;border-radius:var(--r-lg);box-shadow:var(--sh-lg);display:flex;align-items:center;gap:12px}
.hero-art-badge .b-num{font-size:20px;font-weight:900;letter-spacing:-.03em}
.hero-art-badge .b-lbl{font-size:11px;font-weight:600;color:var(--ink-3);text-transform:uppercase;letter-spacing:.08em}
.hero-fade{position:absolute;left:0;right:0;bottom:0;height:300px;background:linear-gradient(to bottom,rgba(246,247,249,0) 0%,rgba(246,247,249,.7) 60%,var(--bg) 100%);pointer-events:none;z-index:2}
.hero-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:52px;height:52px;display:grid;place-items:center;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:50%;color:#fff;backdrop-filter:blur(10px);transition:all .25s var(--ease);opacity:0}
.hero:hover .hero-nav{opacity:1}
.hero-nav:hover{background:rgba(255,255,255,.24);transform:translateY(-50%) scale(1.08)}
.hero-nav.prev{left:26px}
.hero-nav.next{right:26px}
.hero-dots{position:absolute;bottom:190px;left:50%;transform:translateX(-50%);display:flex;gap:10px;z-index:4}
.dot{width:8px;height:8px;border-radius:99px;background:rgba(255,255,255,.4);transition:all .35s var(--ease);border:none}
.dot.active{background:#fff;width:32px;box-shadow:0 0 12px rgba(255,255,255,.5)}

.main{position:relative;z-index:3;margin-top:-320px;padding-bottom:60px}
.trust{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#fff;border-radius:var(--r-lg);box-shadow:var(--sh-sm);margin-bottom:32px;overflow:hidden;border:1px solid var(--line)}
.trust-item{display:flex;align-items:center;gap:14px;padding:22px 26px;border-right:1px solid var(--line);transition:background .2s}
.trust-item:last-child{border-right:none}
.trust-item:hover{background:var(--surface)}
.trust-icon{width:42px;height:42px;border-radius:var(--r);display:grid;place-items:center;background:linear-gradient(135deg,#fff5e6 0%,#ffe8cc 100%);color:var(--orange-d);flex:0 0 auto}
.trust-icon svg{width:22px;height:22px}
.trust-title{font-size:13.5px;font-weight:700;color:var(--ink);line-height:1.3}
.trust-sub{font-size:12px;color:var(--ink-3);font-weight:500;margin-top:2px}
.section{margin-bottom:44px}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}
.section-eyebrow{font-size:11.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-d);margin-bottom:6px}
.section-title{font-size:clamp(22px,2.2vw,29px);font-weight:900;letter-spacing:-.035em;color:var(--ink);line-height:1.1}
.section-link{color:var(--link);font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:6px;transition:color .18s,gap .18s}
.section-link:hover{color:var(--link-h);gap:9px}
.section-link svg{width:14px;height:14px}
.featured-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.f-card{background:#fff;border-radius:var(--r-lg);padding:22px;box-shadow:var(--sh-sm);display:flex;flex-direction:column;transition:box-shadow .3s var(--ease),transform .3s var(--ease);border:1px solid var(--line)}
.f-card:hover{box-shadow:var(--sh-md);transform:translateY(-4px)}
.f-card h3{font-size:17px;font-weight:800;margin-bottom:16px;letter-spacing:-.025em}
.f-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;flex:1}
.f-item{cursor:pointer;position:relative}
.f-img{aspect-ratio:1/1;border-radius:var(--r);overflow:hidden;margin-bottom:8px;background:var(--line-2);transition:transform .4s var(--ease),box-shadow .3s;position:relative}
.f-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.f-item:hover .f-img img{transform:scale(1.09)}
.f-item span{font-size:12px;color:var(--ink-2);line-height:1.35;font-weight:500;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.f-link{margin-top:16px;color:var(--link);font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:6px;transition:gap .2s,color .18s}
.f-link:hover{gap:9px;color:var(--link-h)}
.rail-wrap{position:relative}
.rail{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 4px 20px;scroll-behavior:smooth}
.rail::-webkit-scrollbar{height:8px}
.rail::-webkit-scrollbar-thumb{background:#c8d0d9;border:2px solid var(--bg);border-radius:20px}
.rail-btn{position:absolute;top:calc(50% - 34px);transform:translateY(-50%);z-index:6;width:48px;height:96px;background:#fff;border-radius:var(--r);box-shadow:var(--sh-md);display:grid;place-items:center;color:var(--ink);transition:all .22s var(--ease);border:1px solid var(--line)}
.rail-btn:hover{background:var(--navy);color:#fff;box-shadow:var(--sh-lg)}
.rail-btn.prev{left:-16px}
.rail-btn.next{right:-16px}
.rail-btn:disabled{opacity:0;pointer-events:none}
.rail-btn svg{width:18px;height:18px}
.p-card{background:#fff;border-radius:var(--r-lg);overflow:hidden;display:flex;flex-direction:column;cursor:pointer;position:relative;transition:box-shadow .35s var(--ease),transform .35s var(--ease);scroll-snap-align:start;flex:0 0 244px;border:1px solid var(--line);box-shadow:var(--sh-xs)}
.p-card:hover{box-shadow:var(--sh-lg);transform:translateY(-6px)}
.p-img{aspect-ratio:1/1;position:relative;overflow:hidden;background:var(--line-2)}
.p-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
.p-card:hover .p-img img{transform:scale(1.07)}
.p-badge{position:absolute;top:12px;left:12px;z-index:2;background:linear-gradient(135deg,#c0392b,#96281b);color:#fff;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 10px;border-radius:6px;box-shadow:0 3px 10px rgba(192,57,43,.35)}
.p-badge.choice{background:linear-gradient(135deg,#0b1622,#1e2d3d)}
.p-badge.deal{background:linear-gradient(135deg,#e67a00,#b86000);box-shadow:0 3px 10px rgba(230,122,0,.35)}
.p-wish{position:absolute;top:12px;right:12px;z-index:3;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.94);display:grid;place-items:center;color:var(--ink-3);opacity:0;transform:translateY(-4px);transition:all .25s var(--ease);backdrop-filter:blur(6px)}
.p-card:hover .p-wish{opacity:1;transform:none}
.p-wish:hover{color:var(--red);transform:scale(1.1)}
.p-wish svg{width:16px;height:16px}
.p-body{padding:16px 18px 18px;display:flex;flex-direction:column;flex:1}
.p-cat{font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px}
.p-title{font-size:14px;line-height:1.4;color:var(--ink);margin-bottom:10px;font-weight:600;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:39px;letter-spacing:-.01em}
.p-card:hover .p-title{color:var(--link-h)}
.stars{display:flex;align-items:center;gap:6px;margin-bottom:12px}
.stars-box{position:relative;font-size:13px;letter-spacing:1.5px;line-height:1;color:#e6eaef}
.stars-fill{position:absolute;inset:0;overflow:hidden;color:var(--star);white-space:nowrap}
.stars-n{font-size:11.5px;color:var(--ink-3);font-weight:500;margin-left:2px}
.price-row{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:4px}
.price{font-size:20px;font-weight:900;letter-spacing:-.04em;color:var(--ink)}
.price-old{font-size:12.5px;color:var(--ink-3);text-decoration:line-through;font-weight:500}
.price-off{font-size:12px;color:var(--red);font-weight:800;background:#fdecea;padding:2px 7px;border-radius:5px}
.p-prime{display:flex;align-items:center;gap:6px;margin:8px 0 14px;font-size:11.5px;color:var(--ink-2);font-weight:500}
.prime-logo{color:#00a8e1;font-weight:900;font-style:italic;font-size:12.5px;letter-spacing:-.02em}
.p-prime b{color:var(--ink);font-weight:700}
.add-btn{background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);border-radius:99px;padding:11px 16px;font-size:13px;font-weight:800;color:#1a1204;width:100%;transition:all .2s var(--ease);letter-spacing:-.01em;box-shadow:0 2px 8px rgba(255,138,0,.25);display:flex;align-items:center;justify-content:center;gap:7px}
.add-btn:hover{filter:brightness(1.06);box-shadow:0 6px 18px rgba(255,138,0,.4);transform:translateY(-1px)}
.add-btn:active{transform:scale(.98)}
.add-btn.added{background:linear-gradient(135deg,#067a5c,#04a878);color:#fff;box-shadow:0 4px 14px rgba(6,122,92,.3)}
.add-btn svg{width:14px;height:14px}
.cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
.cat-tile{background:#fff;border-radius:var(--r-lg);padding:20px 14px 18px;text-align:center;box-shadow:var(--sh-xs);cursor:pointer;border:1px solid var(--line);transition:all .3s var(--ease);position:relative;overflow:hidden}
.cat-tile::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,138,0,.06),transparent);opacity:0;transition:opacity .3s}
.cat-tile:hover{transform:translateY(-6px);box-shadow:var(--sh-md);border-color:transparent}
.cat-tile:hover::before{opacity:1}
.cat-img{width:74px;height:74px;border-radius:50%;margin:0 auto 12px;overflow:hidden;background:var(--line-2);position:relative;z-index:1;box-shadow:0 4px 14px rgba(11,22,34,.08);transition:transform .4s var(--ease)}
.cat-img img{width:100%;height:100%;object-fit:cover}
.cat-tile:hover .cat-img{transform:scale(1.06) rotate(-3deg)}
.cat-name{font-size:13px;font-weight:700;color:var(--ink);position:relative;z-index:1;letter-spacing:-.01em}
.cat-count{font-size:11px;color:var(--ink-3);font-weight:500;margin-top:2px;position:relative;z-index:1}
.banner{border-radius:var(--r-xl);overflow:hidden;position:relative;background:linear-gradient(120deg,#0b1622 0%,#13202f 45%,#1e2d3d 100%);color:#fff;padding:56px 60px;display:flex;align-items:center;justify-content:space-between;gap:40px;box-shadow:var(--sh-lg);margin-bottom:44px}
.banner::before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.28),transparent 65%);right:-140px;top:-180px;pointer-events:none}
.banner::after{content:"";position:absolute;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(0,168,225,.14),transparent 65%);left:-100px;bottom:-200px;pointer-events:none}
.banner-copy{position:relative;z-index:2;max-width:600px}
.banner .section-eyebrow{color:var(--amber);margin-bottom:14px}
.banner h2{font-size:clamp(26px,3.2vw,42px);font-weight:900;letter-spacing:-.04em;margin-bottom:14px;line-height:1.1}
.banner p{color:rgba(255,255,255,.8);font-size:16px;margin-bottom:28px;line-height:1.55;max-width:480px}
.banner-art{position:relative;z-index:2;flex:0 0 auto;width:clamp(180px,20vw,260px);height:clamp(180px,20vw,260px);border-radius:var(--r-lg);overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.1);transform:rotate(3deg);transition:transform .5s var(--ease)}
.banner:hover .banner-art{transform:rotate(-2deg) scale(1.03)}
.banner-art img{width:100%;height:100%;object-fit:cover}
.p-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
.p-card.grid-card{flex:unset}

.back-top{display:flex;align-items:center;justify-content:center;gap:10px;background:var(--navy-3);color:#fff;padding:20px;font-size:13.5px;font-weight:600;transition:background .22s}
.back-top:hover{background:#2a3b4d}
.back-top svg{width:14px;height:14px}
.footer-main{background:var(--navy-2);color:#c7d1dc;padding:56px 24px 44px}
.footer-cols{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
.footer-cols h4{color:#fff;font-size:14.5px;margin-bottom:16px;font-weight:800;letter-spacing:-.01em}
.footer-cols li{list-style:none;margin-bottom:11px}
.footer-cols a{font-size:13.5px;color:#a9b6c4;transition:color .16s;font-weight:500}
.footer-cols a:hover{color:#fff;text-decoration:underline}
.footer-bottom{background:var(--navy);border-top:1px solid #2a3b4d;padding:40px 24px 48px;display:flex;flex-direction:column;align-items:center;gap:22px;color:#a9b6c4}
.f-logo{display:flex;flex-direction:column;align-items:center}
.f-logo .logo-text{font-size:28px}
.f-logo .logo-svg{width:92px;height:12px;margin-top:-4px}
.f-links{display:flex;gap:28px;flex-wrap:wrap;justify-content:center;font-size:12.5px;font-weight:500}
.f-links a:hover{text-decoration:underline;color:#fff}
.f-copy{font-size:12px;color:#6b7b8c;text-align:center;font-weight:400}

.overlay{position:fixed;inset:0;background:rgba(10,14,20,.5);backdrop-filter:blur(4px);opacity:0;pointer-events:none;transition:opacity .35s var(--ease);z-index:300}
.overlay.show{opacity:1;pointer-events:auto}
.cart-drawer{position:fixed;top:0;right:0;bottom:0;width:min(460px,100%);background:#fff;z-index:400;display:flex;flex-direction:column;transform:translateX(102%);transition:transform .42s cubic-bezier(.4,0,.2,1);box-shadow:var(--sh-xl)}
.cart-drawer.open{transform:none}
.cart-head{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-2) 100%);color:#fff;padding:24px;display:flex;align-items:center;justify-content:space-between}
.cart-head h3{font-size:18px;font-weight:800;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
.cart-head h3 svg{width:20px;height:20px}
.cart-close{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-size:18px;transition:background .2s,transform .2s}
.cart-close:hover{background:rgba(255,255,255,.14);transform:rotate(90deg)}
.cart-body{flex:1;overflow-y:auto;padding:20px 24px}
.cart-empty{text-align:center;padding:80px 24px;color:var(--ink-2)}
.cart-empty .big{width:96px;height:96px;border-radius:50%;margin:0 auto 22px;background:linear-gradient(135deg,#f6f7f9,#e6eaef);display:grid;place-items:center;color:var(--ink-3)}
.cart-empty .big svg{width:42px;height:42px}
.cart-empty h4{font-size:17px;color:var(--ink);margin-bottom:8px;font-weight:800;letter-spacing:-.02em}
.cart-empty p{font-size:13.5px;color:var(--ink-3);margin-bottom:22px}
.cart-empty .hero-cta{background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);color:#1a1204;font-size:13.5px;padding:12px 26px;box-shadow:0 6px 20px rgba(255,138,0,.3)}
.cart-item{display:flex;gap:16px;padding:20px 0;border-bottom:1px solid var(--line-2);animation:fadeIn .3s var(--ease) both}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.cart-item:first-child{padding-top:0}
.ci-img{width:88px;height:88px;border-radius:var(--r);overflow:hidden;flex:0 0 auto;background:var(--line-2)}
.ci-img img{width:100%;height:100%;object-fit:cover}
.ci-info{flex:1;min-width:0}
.ci-title{font-size:13.5px;line-height:1.4;margin-bottom:6px;font-weight:600;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;letter-spacing:-.01em}
.ci-price{font-weight:900;font-size:16px;margin-bottom:12px;letter-spacing:-.03em}
.ci-controls{display:flex;align-items:center;gap:14px}
.qty{display:flex;align-items:center;border:1px solid var(--line);border-radius:99px;overflow:hidden;background:var(--surface)}
.qty button{width:30px;height:30px;font-size:16px;display:grid;place-items:center;color:var(--ink);transition:background .15s;font-weight:600}
.qty button:hover{background:var(--line-2)}
.qty span{min-width:30px;text-align:center;font-size:13.5px;font-weight:800}
.ci-remove{font-size:12.5px;color:var(--link);border-left:1px solid var(--line);padding-left:14px;font-weight:600;transition:color .18s}
.ci-remove:hover{color:var(--link-h);text-decoration:underline}
.cart-foot{border-top:1px solid var(--line);padding:22px 24px 26px;background:var(--surface)}
.subtotal{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.subtotal .lbl{font-size:14px;font-weight:700;color:var(--ink-2)}
.subtotal .val{font-size:26px;font-weight:900;letter-spacing:-.04em}
.cart-note{font-size:12px;color:var(--green);margin-bottom:16px;font-weight:600;display:flex;align-items:center;gap:6px}
.cart-note svg{width:14px;height:14px}
.checkout-btn{width:100%;background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);border-radius:99px;padding:15px;font-weight:800;font-size:15px;color:#1a1204;transition:all .2s var(--ease);box-shadow:0 6px 20px rgba(255,138,0,.3);letter-spacing:-.01em}
.checkout-btn:hover{filter:brightness(1.06);box-shadow:0 10px 28px rgba(255,138,0,.42);transform:translateY(-1px)}
.checkout-btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;transform:none}

.modal{position:fixed;inset:0;z-index:500;display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .3s var(--ease)}
.modal.open{opacity:1;pointer-events:auto}
.modal-bg{position:absolute;inset:0;background:rgba(10,14,20,.6);backdrop-filter:blur(6px)}
.modal-card{position:relative;background:#fff;border-radius:var(--r-xl);width:min(960px,100%);max-height:92vh;overflow-y:auto;box-shadow:var(--sh-xl);transform:translateY(28px) scale(.96);transition:transform .42s cubic-bezier(.34,1.4,.64,1)}
.modal.open .modal-card{transform:none}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:0}
.modal-art{position:relative;overflow:hidden;min-height:440px;background:var(--line-2);border-radius:var(--r-xl) 0 0 var(--r-xl)}
.modal-art img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.modal-art-badge{position:absolute;top:22px;left:22px;background:#fff;color:var(--ink);padding:8px 14px;border-radius:99px;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;box-shadow:var(--sh-md);display:flex;align-items:center;gap:7px;z-index:2}
.modal-art-badge::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green)}
.modal-info{padding:40px 42px;display:flex;flex-direction:column}
.modal-cat{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--orange-d);margin-bottom:10px}
.modal-info h2{font-size:24px;font-weight:900;line-height:1.2;margin-bottom:14px;letter-spacing:-.03em}
.modal-price{display:flex;align-items:baseline;gap:12px;margin:16px 0 6px;flex-wrap:wrap}
.modal-price .price{font-size:34px}
.modal-price .price-old{font-size:15px}
.modal-price .price-off{font-size:13px;padding:3px 9px}
.stock{color:var(--green);font-weight:700;font-size:13.5px;margin-top:10px;display:flex;align-items:center;gap:7px}
.stock::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px rgba(6,122,92,.15)}
.modal-desc{font-size:14px;color:var(--ink-2);line-height:1.7;margin:20px 0 24px;padding-top:20px;border-top:1px solid var(--line-2)}
.modal-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:auto}
.modal-actions .add-btn{width:auto;padding:14px 34px;font-size:14.5px}
.btn-secondary{background:#fff;border:1.5px solid var(--line);border-radius:99px;padding:13px 28px;font-size:14px;font-weight:700;color:var(--ink);transition:all .2s var(--ease);display:flex;align-items:center;gap:8px}
.btn-secondary:hover{border-color:var(--ink);background:var(--surface)}
.modal-close{position:absolute;top:18px;right:18px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);box-shadow:var(--sh-md);display:grid;place-items:center;font-size:18px;z-index:5;transition:all .2s var(--ease);color:var(--ink)}
.modal-close:hover{background:#fff;transform:rotate(90deg) scale(1.05)}
.modal-meta{font-size:12.5px;color:var(--ink-3);margin-top:20px;padding-top:20px;border-top:1px solid var(--line-2);display:flex;flex-direction:column;gap:8px}
.modal-meta div{display:flex;align-items:center;gap:8px}
.modal-meta svg{width:14px;height:14px;color:var(--green);flex:0 0 auto}

.toast-stack{position:fixed;bottom:32px;left:50%;transform:translateX(-50%);z-index:900;display:flex;flex-direction:column;gap:12px;align-items:center;pointer-events:none}
.toast{background:var(--navy);color:#fff;padding:14px 24px;border-radius:99px;font-size:13.5px;font-weight:600;box-shadow:var(--sh-xl);display:flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.1);animation:toastIn .42s cubic-bezier(.34,1.4,.64,1) both;letter-spacing:-.01em}
.toast.out{animation:toastOut .32s ease forwards}
@keyframes toastIn{from{opacity:0;transform:translateY(28px) scale(.9)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateY(16px) scale(.96)}}
.toast .tick{width:22px;height:22px;border-radius:50%;background:var(--green);display:grid;place-items:center;flex:0 0 auto}
.toast .tick svg{width:12px;height:12px;color:#fff}
.toast.error .tick{background:var(--red)}
.toast.warn .tick{background:var(--orange)}

.auth-modal{position:fixed;inset:0;z-index:600;display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .32s var(--ease)}
.auth-modal.open{opacity:1;pointer-events:auto}
.auth-bg{position:absolute;inset:0;background:rgba(10,14,20,.7);backdrop-filter:blur(10px)}
.auth-card{position:relative;background:#fff;border-radius:var(--r-xl);width:min(940px,100%);max-height:94vh;overflow:hidden;box-shadow:var(--sh-xl);display:grid;grid-template-columns:1fr 1fr;transform:translateY(28px) scale(.96);transition:transform .42s cubic-bezier(.34,1.4,.64,1)}
.auth-modal.open .auth-card{transform:none}
.auth-brand{background:linear-gradient(150deg,#0b1622 0%,#13202f 45%,#1e2d3d 100%);color:#fff;padding:48px 44px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.auth-brand::before{content:"";position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.28),transparent 65%);right:-160px;top:-120px}
.auth-brand::after{content:"";position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(0,168,225,.16),transparent 65%);left:-120px;bottom:-140px}
.auth-brand > *{position:relative;z-index:1}
.auth-logo{display:flex;flex-direction:column;margin-bottom:44px;align-self:flex-start}
.auth-logo .logo-text{font-size:24px}
.auth-logo .logo-svg{width:78px;height:10px;margin-top:-3px;margin-left:4px}
.auth-brand h2{font-size:clamp(24px,2.4vw,32px);font-weight:900;letter-spacing:-.04em;line-height:1.1;margin-bottom:14px}
.auth-brand h2 em{font-style:normal;color:var(--amber)}
.auth-brand p{font-size:14px;color:rgba(255,255,255,.72);line-height:1.65;margin-bottom:34px}
.auth-features{display:flex;flex-direction:column;gap:14px}
.auth-feature{display:flex;align-items:center;gap:12px;font-size:13.5px;color:rgba(255,255,255,.88);font-weight:500}
.auth-feature-icon{width:32px;height:32px;border-radius:9px;background:rgba(255,138,0,.18);display:grid;place-items:center;color:var(--amber);flex:0 0 auto;border:1px solid rgba(255,138,0,.25)}
.auth-feature-icon svg{width:16px;height:16px}
.auth-brand-footer{margin-top:auto;font-size:11.5px;color:rgba(255,255,255,.45);padding-top:30px}
.auth-form-panel{padding:44px 44px 40px;display:flex;flex-direction:column;overflow-y:auto;max-height:94vh}
.auth-close{position:absolute;top:18px;right:18px;width:38px;height:38px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-size:16px;color:var(--ink);transition:all .2s var(--ease);z-index:5}
.auth-close:hover{background:var(--line);transform:rotate(90deg)}
.role-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:5px;margin-bottom:26px}
.role-tab{display:flex;flex-direction:column;align-items:center;gap:5px;padding:11px 8px;border-radius:var(--r-sm);font-size:12px;font-weight:700;color:var(--ink-2);transition:all .22s var(--ease);letter-spacing:-.01em;position:relative}
.role-tab svg{width:18px;height:18px;transition:transform .22s var(--ease)}
.role-tab:hover{color:var(--ink)}
.role-tab.active{background:#fff;color:var(--ink);box-shadow:var(--sh-sm)}
.role-tab.active svg{transform:scale(1.1)}
.role-tab.active[data-role="customer"]{color:#b86000}
.role-tab.active[data-role="seller"]{color:#067a9e}
.role-tab.active[data-role="admin"]{color:#6b21a8}
.auth-heading{margin-bottom:22px}
.auth-heading h3{font-size:22px;font-weight:900;letter-spacing:-.03em;margin-bottom:6px}
.auth-heading p{font-size:13.5px;color:var(--ink-2);line-height:1.5}
.auth-heading p b{color:var(--ink);font-weight:700}
.field{margin-bottom:16px}
.field label{display:block;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:7px;letter-spacing:-.01em}
.field-wrap{position:relative;display:flex;align-items:center}
.field-wrap svg.f-icon{position:absolute;left:14px;width:16px;height:16px;color:var(--ink-3);pointer-events:none}
.field input{width:100%;background:var(--surface);border:1.5px solid var(--line);border-radius:var(--r);padding:12px 14px 12px 42px;font-size:14px;color:var(--ink);transition:all .2s var(--ease);outline:none;font-weight:500}
.field input::placeholder{color:#a0aec0;font-weight:400}
.field input:focus{border-color:var(--orange);background:#fff;box-shadow:0 0 0 4px rgba(255,138,0,.14)}
.field input.error{border-color:var(--red);background:#fff5f5}
.field-toggle{position:absolute;right:12px;width:28px;height:28px;display:grid;place-items:center;color:var(--ink-3);border-radius:50%;transition:background .18s}
.field-toggle:hover{background:var(--line-2)}
.field-toggle svg{width:16px;height:16px}
.field-error{font-size:11.5px;color:var(--red);font-weight:600;margin-top:6px;display:none}
.field-error.show{display:block}
.auth-row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:6px 0 20px;font-size:12.5px}
.checkbox{display:flex;align-items:center;gap:8px;cursor:pointer;color:var(--ink-2);font-weight:500;user-select:none}
.checkbox input{position:absolute;opacity:0;pointer-events:none}
.checkbox .box{width:17px;height:17px;border:1.5px solid var(--line);border-radius:5px;background:#fff;display:grid;place-items:center;transition:all .18s;flex:0 0 auto}
.checkbox .box svg{width:11px;height:11px;color:#fff;opacity:0;transform:scale(.6);transition:all .18s}
.checkbox input:checked + .box{background:var(--orange);border-color:var(--orange)}
.checkbox input:checked + .box svg{opacity:1;transform:none}
.auth-forgot{color:var(--link);font-weight:600}
.auth-forgot:hover{color:var(--link-h);text-decoration:underline}
.auth-submit{width:100%;background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);border-radius:99px;padding:14px;font-weight:800;font-size:14.5px;color:#1a1204;transition:all .2s var(--ease);box-shadow:0 6px 20px rgba(255,138,0,.3);letter-spacing:-.01em;display:flex;align-items:center;justify-content:center;gap:9px}
.auth-submit:hover{filter:brightness(1.06);box-shadow:0 10px 28px rgba(255,138,0,.42);transform:translateY(-1px)}
.auth-submit:active{transform:scale(.99)}
.auth-submit:disabled{opacity:.7;cursor:wait}
.auth-submit.loading .spinner{display:block}
.auth-submit.loading .label{display:none}
.spinner{display:none;width:16px;height:16px;border:2px solid rgba(26,18,4,.3);border-top-color:#1a1204;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.auth-switch{text-align:center;font-size:13px;color:var(--ink-2);margin-top:20px;font-weight:500}
.auth-switch button{color:var(--link);font-weight:700;transition:color .18s}
.auth-switch button:hover{color:var(--link-h);text-decoration:underline}
.demo-creds{margin-top:22px;padding:16px;background:linear-gradient(135deg,#fffbf2,#fff5e0);border:1px dashed rgba(255,138,0,.4);border-radius:var(--r)}
.demo-creds h5{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--orange-d);margin-bottom:10px;display:flex;align-items:center;gap:6px}
.demo-creds h5 svg{width:13px;height:13px}
.demo-row{display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:7px;color:var(--ink-2);cursor:pointer;padding:6px 8px;border-radius:6px;transition:background .16s}
.demo-row:last-child{margin-bottom:0}
.demo-row:hover{background:rgba(255,138,0,.09)}
.demo-role{font-weight:800;color:var(--ink);min-width:66px}
.demo-creds code{background:rgba(255,255,255,.7);padding:2px 7px;border-radius:4px;font-size:11px;font-family:'SF Mono',Menlo,Consolas,monospace;color:#1a1204;border:1px solid rgba(255,138,0,.2)}
.demo-row .fill{margin-left:auto;font-size:10.5px;font-weight:700;color:var(--orange-d);opacity:0;transition:opacity .18s}
.demo-row:hover .fill{opacity:1}
.auth-social{margin-top:22px;padding-top:22px;border-top:1px solid var(--line-2)}
.auth-social-lbl{text-align:center;font-size:11.5px;color:var(--ink-3);font-weight:600;margin-bottom:14px;letter-spacing:.04em}
.social-btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.social-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:11px;border:1.5px solid var(--line);border-radius:var(--r);font-size:13px;font-weight:700;color:var(--ink);transition:all .18s}
.social-btn:hover{border-color:var(--ink);background:var(--surface)}
.social-btn svg{width:17px;height:17px}

.dash-modal{position:fixed;inset:0;z-index:620;display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .32s var(--ease)}
.dash-modal.open{opacity:1;pointer-events:auto}
.dash-bg{position:absolute;inset:0;background:rgba(10,14,20,.7);backdrop-filter:blur(10px)}
.dash-card{position:relative;background:#fff;border-radius:var(--r-xl);width:min(1180px,100%);max-height:92vh;overflow:hidden;box-shadow:var(--sh-xl);display:flex;flex-direction:column;transform:translateY(28px) scale(.97);transition:transform .42s cubic-bezier(.34,1.4,.64,1)}
.dash-modal.open .dash-card{transform:none}
.dash-top{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-2) 100%);color:#fff;padding:24px 30px;display:flex;align-items:center;gap:18px;border-bottom:1px solid rgba(255,255,255,.08)}
.dash-avatar{width:52px;height:52px;border-radius:14px;flex:0 0 auto;display:grid;place-items:center;font-weight:800;font-size:19px;background:linear-gradient(135deg,var(--orange),var(--amber));color:#1a1204}
.dash-avatar.admin{background:linear-gradient(135deg,#7c3aed,#a78bfa);color:#fff}
.dash-avatar.seller{background:linear-gradient(135deg,#0891b2,#22d3ee);color:#fff}
.dash-head-info{flex:1;min-width:0}
.dash-head-info h3{font-size:19px;font-weight:900;letter-spacing:-.02em;margin-bottom:4px}
.dash-head-info p{font-size:13px;color:rgba(255,255,255,.68);font-weight:500}
.dash-tag{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:99px;margin-left:8px}
.dash-tag.admin{background:rgba(167,139,250,.22);color:#d8b4fe;border:1px solid rgba(167,139,250,.35)}
.dash-tag.seller{background:rgba(34,211,238,.2);color:#67e8f9;border:1px solid rgba(34,211,238,.35)}
.dash-tag.customer{background:rgba(255,201,120,.2);color:var(--amber);border:1px solid rgba(255,201,120,.35)}
.dash-close{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);display:grid;place-items:center;font-size:16px;color:#fff;transition:all .2s var(--ease)}
.dash-close:hover{background:rgba(255,255,255,.2);transform:rotate(90deg)}
.dash-body{padding:28px 30px;overflow-y:auto;flex:1;background:var(--bg)}
.dash-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:26px}
.stat-card{background:#fff;border-radius:var(--r-lg);padding:20px;border:1px solid var(--line);box-shadow:var(--sh-xs);transition:all .25s var(--ease)}
.stat-card:hover{box-shadow:var(--sh-md);transform:translateY(-2px)}
.stat-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;margin-bottom:14px}
.stat-icon.orange{background:#fff5e6;color:var(--orange-d)}
.stat-icon.green{background:#e6f7f1;color:var(--green)}
.stat-icon.blue{background:#e0f2fe;color:#0284c7}
.stat-icon.purple{background:#f3e8ff;color:var(--purple)}
.stat-icon.red{background:#fdecea;color:var(--red)}
.stat-icon svg{width:19px;height:19px}
.stat-val{font-size:26px;font-weight:900;letter-spacing:-.035em;line-height:1;margin-bottom:5px}
.stat-lbl{font-size:12px;color:var(--ink-3);font-weight:600;letter-spacing:.01em}
.stat-delta{font-size:11.5px;font-weight:700;margin-top:6px;display:flex;align-items:center;gap:4px}
.stat-delta.up{color:var(--green)}
.stat-delta.down{color:var(--red)}
.dash-panel{background:#fff;border-radius:var(--r-lg);border:1px solid var(--line);box-shadow:var(--sh-xs);overflow:hidden;margin-bottom:20px}
.dash-panel-head{padding:18px 22px;border-bottom:1px solid var(--line-2);display:flex;align-items:center;justify-content:space-between;gap:14px}
.dash-panel-head h4{font-size:15px;font-weight:800;letter-spacing:-.02em;display:flex;align-items:center;gap:9px}
.dash-panel-head h4 svg{width:16px;height:16px;color:var(--orange-d)}
.dash-panel-head .actions{display:flex;gap:8px}
.dash-btn{padding:8px 16px;border-radius:99px;font-size:12.5px;font-weight:700;transition:all .18s;border:1.5px solid var(--line);color:var(--ink);display:inline-flex;align-items:center;gap:6px}
.dash-btn:hover{border-color:var(--ink);background:var(--surface)}
.dash-btn.primary{background:linear-gradient(135deg,var(--amber) 0%,var(--orange) 100%);color:#1a1204;border-color:transparent;box-shadow:0 3px 10px rgba(255,138,0,.25)}
.dash-btn.primary:hover{filter:brightness(1.06);transform:translateY(-1px)}
.dash-btn svg{width:13px;height:13px}
.dash-table{width:100%;border-collapse:collapse;font-size:13px}
.dash-table th{text-align:left;padding:12px 22px;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);background:var(--surface);border-bottom:1px solid var(--line)}
.dash-table td{padding:14px 22px;border-bottom:1px solid var(--line-2);font-weight:500;vertical-align:middle}
.dash-table tr:last-child td{border-bottom:none}
.dash-table tr:hover td{background:var(--surface)}
.td-product{display:flex;align-items:center;gap:12px}
.td-product img{width:40px;height:40px;border-radius:8px;object-fit:cover;background:var(--line-2);flex:0 0 auto}
.td-product .info{min-width:0}
.td-product .name{font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:280px;font-size:13px}
.td-product .meta{font-size:11.5px;color:var(--ink-3);font-weight:500;margin-top:2px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:800;padding:4px 11px;border-radius:99px;letter-spacing:.02em;text-transform:uppercase}
.pill::before{content:"";width:6px;height:6px;border-radius:50%}
.pill.active{background:#e6f7f1;color:var(--green)}
.pill.active::before{background:var(--green)}
.pill.pending{background:#fff5e6;color:var(--orange-d)}
.pill.pending::before{background:var(--orange-d)}
.pill.paused{background:#f1f4f8;color:var(--ink-2)}
.pill.paused::before{background:var(--ink-3)}
.pill.admin{background:#f3e8ff;color:var(--purple)}
.pill.admin::before{background:var(--purple)}
.pill.seller{background:#e0f7fa;color:#067a9e}
.pill.seller::before{background:#0891b2}
.pill.customer{background:#fff5e6;color:#b86000}
.pill.customer::before{background:var(--orange-d)}
.pill.refunded{background:#fdecea;color:var(--red)}
.pill.refunded::before{background:var(--red)}
.pill.success{background:#e6f7f1;color:var(--green)}
.pill.success::before{background:var(--green)}
.dash-chart{padding:24px 22px;display:flex;align-items:flex-end;gap:14px;height:220px}
.chart-bar{flex:1;background:linear-gradient(to top,var(--orange),var(--amber));border-radius:8px 8px 0 0;position:relative;min-height:20px;transition:all .3s var(--ease);opacity:.85}
.chart-bar:hover{opacity:1;transform:scaleY(1.03)}
.chart-bar::after{content:attr(data-val);position:absolute;top:-22px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:800;color:var(--ink);opacity:0;transition:opacity .2s;white-space:nowrap}
.chart-bar:hover::after{opacity:1}
.chart-labels{display:flex;gap:14px;padding:0 22px 18px}
.chart-labels span{flex:1;text-align:center;font-size:11px;font-weight:600;color:var(--ink-3)}

.payout-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:22px}
.payout-card{background:linear-gradient(135deg,#0b1622 0%,#13202f 60%,#1e2d3d 100%);color:#fff;border-radius:var(--r-lg);padding:26px;position:relative;overflow:hidden;box-shadow:var(--sh-md)}
.payout-card::before{content:"";position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(255,138,0,.3),transparent 65%);right:-80px;top:-100px}
.payout-card > *{position:relative;z-index:1}
.payout-lbl{font-size:11.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin-bottom:10px}
.payout-val{font-size:38px;font-weight:900;letter-spacing:-.045em;line-height:1;margin-bottom:8px}
.payout-sub{font-size:13px;color:rgba(255,255,255,.7);margin-bottom:20px}
.payout-actions{display:flex;gap:10px;flex-wrap:wrap}
.payout-btn{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);color:#fff;padding:10px 18px;border-radius:99px;font-size:12.5px;font-weight:700;transition:all .2s;display:flex;align-items:center;gap:7px}
.payout-btn:hover{background:rgba(255,255,255,.24)}
.payout-btn.primary{background:linear-gradient(135deg,var(--amber),var(--orange));border-color:transparent;color:#1a1204;box-shadow:0 4px 14px rgba(255,138,0,.35)}
.payout-btn.primary:hover{filter:brightness(1.06)}
.payout-btn svg{width:13px;height:13px}
.bank-card{background:#fff;border-radius:var(--r-lg);border:1px solid var(--line);padding:22px;box-shadow:var(--sh-xs)}
.bank-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.bank-card-head h5{font-size:13.5px;font-weight:800;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
.bank-card-head h5 svg{width:15px;height:15px;color:var(--ink-3)}
.bank-card-head button{font-size:11.5px;color:var(--link);font-weight:700}
.bank-name{font-size:14px;font-weight:800;color:var(--ink);margin-bottom:4px}
.bank-detail{font-size:12.5px;color:var(--ink-2);font-weight:500;letter-spacing:.02em}
.bank-status{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;padding:4px 10px;border-radius:99px;margin-top:12px;text-transform:uppercase;letter-spacing:.04em}
.bank-status.verified{background:#e6f7f1;color:var(--green)}
.bank-status.verified::before{content:"●";font-size:8px}
.txn-row{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line-2)}
.txn-row:last-child{border-bottom:none}
.txn-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto}
.txn-icon.card{background:#e0f2fe;color:#0284c7}
.txn-icon.upi{background:#f3e8ff;color:var(--purple)}
.txn-icon.paypal{background:#e0f7fa;color:#067a9e}
.txn-icon.wallet{background:#fff5e6;color:var(--orange-d)}
.txn-icon.cod{background:#f1f4f8;color:var(--ink-2)}
.txn-icon.refund{background:#fdecea;color:var(--red)}
.txn-icon svg{width:17px;height:17px}
.txn-info{flex:1;min-width:0}
.txn-title{font-size:13px;font-weight:700;color:var(--ink);letter-spacing:-.01em}
.txn-meta{font-size:11.5px;color:var(--ink-3);font-weight:500;margin-top:2px}
.txn-amt{font-size:14px;font-weight:900;letter-spacing:-.02em;text-align:right}
.txn-amt.positive{color:var(--green)}
.txn-amt.negative{color:var(--ink)}

.checkout-modal{position:fixed;inset:0;z-index:650;display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .32s var(--ease)}
.checkout-modal.open{opacity:1;pointer-events:auto}
.checkout-bg{position:absolute;inset:0;background:rgba(10,14,20,.72);backdrop-filter:blur(10px)}
.checkout-card{position:relative;background:#fff;border-radius:var(--r-xl);width:min(1080px,100%);max-height:94vh;overflow:hidden;box-shadow:var(--sh-xl);display:grid;grid-template-columns:1.4fr 1fr;transform:translateY(28px) scale(.96);transition:transform .42s cubic-bezier(.34,1.4,.64,1)}
.checkout-modal.open .checkout-card{transform:none}
.checkout-main{padding:36px 40px;overflow-y:auto;max-height:94vh;display:flex;flex-direction:column}
.checkout-side{background:var(--surface);border-left:1px solid var(--line);padding:36px 32px;overflow-y:auto;max-height:94vh}
.checkout-close{position:absolute;top:18px;right:18px;width:38px;height:38px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-size:16px;color:var(--ink);transition:all .2s var(--ease);z-index:5}
.checkout-close:hover{background:var(--line);transform:rotate(90deg)}
.checkout-logo{display:flex;flex-direction:column;margin-bottom:26px;align-self:flex-start}
.checkout-logo .logo-text{font-size:20px}
.checkout-logo .logo-svg{width:68px;height:9px;margin-top:-2px;margin-left:3px}
.stepper{display:flex;align-items:center;gap:8px;margin-bottom:30px}
.step{display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;color:var(--ink-3);white-space:nowrap}
.step-num{width:26px;height:26px;border-radius:50%;background:var(--surface);border:1.5px solid var(--line);display:grid;place-items:center;font-size:11.5px;font-weight:800;transition:all .25s var(--ease)}
.step.active{color:var(--ink)}
.step.active .step-num{background:linear-gradient(135deg,var(--amber),var(--orange));border-color:transparent;color:#1a1204;box-shadow:0 3px 10px rgba(255,138,0,.3)}
.step.done{color:var(--green)}
.step.done .step-num{background:var(--green);border-color:var(--green);color:#fff}
.step.done .step-num::before{content:"✓";font-size:12px}
.step.done .step-num span{display:none}
.step-line{flex:1;height:2px;background:var(--line);border-radius:2px;min-width:20px}
.step-line.done{background:var(--green)}
.pay-methods{display:flex;flex-direction:column;gap:10px;margin-bottom:22px}
.pay-method{display:flex;align-items:center;gap:14px;padding:16px;border:1.5px solid var(--line);border-radius:var(--r);cursor:pointer;transition:all .2s var(--ease);position:relative;background:#fff}
.pay-method:hover{border-color:var(--ink-3);background:var(--surface)}
.pay-method.selected{border-color:var(--orange);background:#fffbf2;box-shadow:0 0 0 3px rgba(255,138,0,.14)}
.pay-radio{width:20px;height:20px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;flex:0 0 auto;transition:all .2s var(--ease)}
.pay-method.selected .pay-radio{border-color:var(--orange);background:var(--orange)}
.pay-method.selected .pay-radio::after{content:"";width:7px;height:7px;border-radius:50%;background:#fff}
.pay-logo{width:44px;height:30px;border-radius:6px;display:grid;place-items:center;font-weight:900;font-size:11px;flex:0 0 auto;border:1px solid var(--line-2)}
.pay-logo.visa{background:linear-gradient(135deg,#1a1f71,#2d3cb8);color:#fff}
.pay-logo.mc{background:linear-gradient(135deg,#eb001b 45%,#f79e1b 55%);color:#fff;font-size:12px}
.pay-logo.amex{background:linear-gradient(135deg,#016fd0,#0090d4);color:#fff;font-size:9px}
.pay-logo.upi{background:linear-gradient(135deg,#097939,#28a745);color:#fff;font-size:11px}
.pay-logo.pp{background:linear-gradient(135deg,#003087,#0070ba);color:#fff;font-size:11px}
.pay-logo.ap{background:#000;color:#fff;font-size:12px}
.pay-logo.wallet{background:linear-gradient(135deg,var(--purple),#a78bfa);color:#fff;font-size:10px}
.pay-logo.cod{background:linear-gradient(135deg,#4a5568,#718096);color:#fff;font-size:10px}
.pay-logo.pix{background:linear-gradient(135deg,#32bcad,#0d7a70);color:#fff;font-size:12px}
.pay-logo.sepa{background:linear-gradient(135deg,#003399,#0055cc);color:#fff;font-size:9px}
.pay-logo.konbini{background:linear-gradient(135deg,#e60012,#ff4d5e);color:#fff;font-size:8px}
.pay-logo.alipay{background:linear-gradient(135deg,#1677ff,#4ea1ff);color:#fff;font-size:10px}
.pay-logo.oxxo{background:linear-gradient(135deg,#da291c,#e85e51);color:#fff;font-size:10px}
.pay-logo.generic{background:var(--surface);color:var(--ink-2);font-size:10px}
.pay-info{flex:1;min-width:0}
.pay-name{font-size:13.5px;font-weight:800;color:var(--ink);letter-spacing:-.01em}
.pay-desc{font-size:11.5px;color:var(--ink-3);font-weight:500;margin-top:1px}
.pay-tag{font-size:10px;font-weight:800;color:var(--green);background:#e6f7f1;padding:3px 8px;border-radius:99px;letter-spacing:.04em;text-transform:uppercase}
.card-form{padding:20px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);margin-bottom:20px;animation:fadeIn .3s var(--ease) both}
.card-visual{background:linear-gradient(135deg,#0b1622 0%,#1e2d3d 50%,#2a3b4d 100%);color:#fff;border-radius:14px;padding:22px;margin-bottom:20px;position:relative;overflow:hidden;box-shadow:var(--sh-md);aspect-ratio:1.586/1;max-width:340px}
