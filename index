/* CART */
function addToCart(id, qty){
  qty = qty || 1;
  var existing = cart.find(function(i){ return i.id === id; });
  if(existing) existing.qty += qty;
  else cart.push({id:id, qty:qty});
  updateCartUI();
  pulseCart();
  toast('Added to Cart');
  var btn = document.querySelector('[data-add="'+id+'"]');
  if(btn){
    var orig = btn.innerHTML;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg> Added';
    btn.classList.add('added');
    setTimeout(function(){ btn.innerHTML = orig; btn.classList.remove('added'); }, 1400);
  }
}
function removeFromCart(id){ cart = cart.filter(function(i){ return i.id !== id; }); updateCartUI(); }
function changeQty(id, delta){
  var item = cart.find(function(i){ return i.id === id; });
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0) removeFromCart(id);
  else updateCartUI();
}
function cartTotals(){
  var count = cart.reduce(function(s,i){ return s + i.qty; }, 0);
  var subtotalUSD = cart.reduce(function(s,i){ return s + byId(i.id).price * i.qty; }, 0);
  return {count:count, subtotalUSD:subtotalUSD};
}
function updateCartUI(){
  var t = cartTotals();
  var freeShipUSD = 35;
  $('#cartCount').textContent = t.count;
  $('#cartHeadCount').textContent = t.count ? '(' + t.count + ')' : '';
  $('#cartSubtotal').textContent = formatPrice(t.subtotalUSD);
  $('#cartNote').innerHTML = t.subtotalUSD >= freeShipUSD || t.subtotalUSD === 0
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg> Your order qualifies for FREE Shipping'
    : 'Add ' + formatPrice(freeShipUSD - t.subtotalUSD) + ' more for FREE Shipping';
  $('#cartNote').style.color = t.subtotalUSD >= freeShipUSD || t.subtotalUSD === 0 ? 'var(--green)' : 'var(--ink-2)';
  $('#checkoutBtn').disabled = t.count === 0;

  var body = $('#cartBody');
  if(!cart.length){
    body.innerHTML = '<div class="cart-empty"><div class="big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></div><h4>Your NexaMart Cart is empty</h4><p>Discover today\'s deals and add something you love.</p><button class="hero-cta" onclick="closeCart(); document.querySelector(\'#deals\').scrollIntoView({behavior:\'smooth\'})">Shop today\'s deals</button></div>';
    return;
  }
  body.innerHTML = cart.map(function(item){
    var p = byId(item.id);
    return '<div class="cart-item"><div class="ci-img"><img src="'+p.img+'" alt="'+p.title+'"></div><div class="ci-info"><div class="ci-title">'+p.title+'</div><div class="ci-price">'+formatPrice(p.price * item.qty)+'</div><div class="ci-controls"><div class="qty"><button data-qty="'+p.id+'" data-delta="-1">−</button><span>'+item.qty+'</span><button data-qty="'+p.id+'" data-delta="1">+</button></div><button class="ci-remove" data-remove="'+p.id+'">Delete</button></div></div></div>';
  }).join('');
}
function pulseCart(){
  var el = $('#cartCount');
  el.classList.add('pop');
  setTimeout(function(){ el.classList.remove('pop'); }, 260);
}
function openCart(){
  $('#cartDrawer').classList.add('open');
  $('#overlay').classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeCart(){
  $('#cartDrawer').classList.remove('open');
  $('#overlay').classList.remove('show');
  if(!$('#modal').classList.contains('open') && !$('#authModal').classList.contains('open') && !$('#dashModal').classList.contains('open') && !$('#checkoutModal').classList.contains('open') && !$('#payManageModal').classList.contains('open')){
    document.body.style.overflow = '';
  }
}

/* QUICK VIEW */
function openQuick(id, silent){
  var p = byId(id);
  var off = p.old ? Math.round((1 - p.price / p.old) * 100) : 0;
  $('#modalGrid').innerHTML = '<div class="modal-art"><div class="modal-art-badge">In Stock</div><img src="'+p.img+'" alt="'+p.title+'"></div><div class="modal-info"><div class="modal-cat">'+p.cat+' · by '+p.seller+'</div><h2>'+p.title+'</h2>'+starHTML(p.rating,p.reviews)+'<div class="modal-price"><span class="price">'+formatPrice(p.price)+'</span>'+(p.old?'<span class="price-old">'+formatPrice(p.old)+'</span><span class="price-off">Save '+off+'%</span>':'')+'</div><div class="stock">In Stock — ships today</div><p class="modal-desc">'+p.title+' — a top pick in <b>'+p.cat+'</b>. Backed by thousands of verified customer reviews and eligible for free two-day delivery with Nexa+.</p><div class="modal-actions"><button class="add-btn" data-add="'+p.id+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Add to Cart</button><button class="btn-secondary" data-add-close="'+p.id+'">Buy Now</button></div><div class="modal-meta"><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Free delivery with Nexa+ on orders over '+formatPrice(35)+'</div><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>30-day returns · refunds in 3–5 days</div><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Secure payment · '+getPaymentMethods().length+' methods in '+COUNTRIES[currentCountry].name+'</div></div></div>';
  if(!silent){ $('#modal').classList.add('open'); document.body.style.overflow = 'hidden'; }
}
function closeModal(){
  $('#modal').classList.remove('open');
  if(!$('#cartDrawer').classList.contains('open') && !$('#authModal').classList.contains('open') && !$('#dashModal').classList.contains('open') && !$('#checkoutModal').classList.contains('open') && !$('#payManageModal').classList.contains('open')){
    document.body.style.overflow = '';
  }
}

/* SEARCH */
function runSearch(query){
  var q = query.trim().toLowerCase();
  var box = $('#suggest');
  var cat = $('#searchCat').value;
  if(!q){ box.classList.remove('open'); box.innerHTML = ''; return; }
  var pool = PRODUCTS;
  if(cat !== 'All') pool = pool.filter(function(p){ return p.cat === cat; });
  var matches = pool.filter(function(p){ return p.title.toLowerCase().indexOf(q) > -1 || p.cat.toLowerCase().indexOf(q) > -1; }).slice(0,7);
  if(!matches.length){
    box.innerHTML = '<div class="sug-empty">No results for "<b>'+query+'</b>"</div>';
    box.classList.add('open');
    return;
  }
  box.innerHTML = matches.map(function(p){
    return '<div class="sug-item" data-quick="'+p.id+'"><div class="sug-img"><img src="'+p.img+'" alt=""></div><div class="sug-txt"><div class="sug-title">'+p.title+'</div><div class="sug-cat">in '+p.cat+'</div></div><div class="sug-price">'+formatPrice(p.price)+'</div></div>';
  }).join('');
  box.classList.add('open');
}

/* TOAST */
function toast(msg, sub, type){
  var stack = $('#toasts');
  if(!stack) return;
  var el = document.createElement('div');
  el.className = 'toast' + (type ? ' ' + type : '');
  var icon = (type === 'error' || type === 'warn')
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/></svg>'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>';
  el.innerHTML = '<span class="tick">'+icon+'</span> ' + msg;
  stack.appendChild(el);
  setTimeout(function(){ el.classList.add('out'); setTimeout(function(){ el.remove(); }, 340); }, 2400);
}

/* SCROLL REVEAL */
function initReveal(){
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'none';
        io.unobserve(entry.target);
      }
    });
  }, {threshold:0.08, rootMargin:'0px 0px -40px 0px'});
  $$('.reveal').forEach(function(el){
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1)';
    io.observe(el);
  });
}

function initHeaderScroll(){
  var header = $('#header');
  var onScroll = function(){ header.classList.toggle('scrolled', window.scrollY > 10); };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
}

/* MAIN CLICK HANDLER */
document.addEventListener('click', function(e){
  var addBtn = e.target.closest('[data-add]');
  if(addBtn){ e.stopPropagation(); addToCart(addBtn.dataset.add); return; }
  var buyNow = e.target.closest('[data-add-close]');
  if(buyNow){ addToCart(buyNow.dataset.addClose); closeModal(); openCart(); return; }
  var qBtn = e.target.closest('[data-qty]');
  if(qBtn){ changeQty(qBtn.dataset.qty, Number(qBtn.dataset.delta)); return; }
  var rm = e.target.closest('[data-remove]');
  if(rm){ removeFromCart(rm.dataset.remove); return; }
  var quick = e.target.closest('[data-quick]');
  if(quick){ $('#suggest').classList.remove('open'); openQuick(quick.dataset.quick); return; }
  var catTile = e.target.closest('[data-cat]');
  if(catTile){
    var cat = catTile.dataset.cat;
    var items = PRODUCTS.filter(function(p){ return p.cat === cat; });
    $('#recGrid').innerHTML = items.map(function(p){ return productCardHTML(p, true); }).join('');
    $('#recGrid').scrollIntoView({behavior:'smooth', block:'center'});
    $('#recGrid').previousElementSibling.querySelector('.section-title').textContent = cat + ' — ' + items.length + ' results';
    toast('Showing ' + items.length + ' items in ' + cat);
    return;
  }
  var railBtn = e.target.closest('.rail-btn');
  if(railBtn){
    var rail = document.getElementById(railBtn.dataset.rail);
    rail.scrollBy({left: Number(railBtn.dataset.dir) * 520, behavior:'smooth'});
    return;
  }
  var dot = e.target.closest('.dot');
  if(dot){ goSlide(Number(dot.dataset.slide)); restartSlides(); return; }
  if(e.target.closest('[data-close-modal]')){ closeModal(); return; }
});

document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){
    closeModal(); closeCart(); closeAuth(); closeDashboard(); closeCheckout(); closePayManage();
    var s = $('#suggest'); if(s) s.classList.remove('open');
  }
  if(e.key === 'Enter'){
    var ae = document.activeElement;
    var card = ae && ae.closest ? ae.closest('.p-card') : null;
    if(card) openQuick(card.dataset.quick);
  }
});

$('#cartBtn').addEventListener('click', openCart);
$('#cartClose').addEventListener('click', closeCart);
$('#overlay').addEventListener('click', closeCart);
$('#checkoutBtn').addEventListener('click', openCheckout);

var searchInput = $('#searchInput');
searchInput.addEventListener('input', function(e){ runSearch(e.target.value); });
searchInput.addEventListener('focus', function(e){ if(e.target.value) runSearch(e.target.value); });
$('#searchCat').addEventListener('change', function(){ runSearch(searchInput.value); });
$('#searchBtn').addEventListener('click', function(){
  var q = searchInput.value.trim().toLowerCase();
  if(!q) return;
  var cat = $('#searchCat').value;
  var pool = cat === 'All' ? PRODUCTS : PRODUCTS.filter(function(p){ return p.cat === cat; });
  var matches = pool.filter(function(p){ return p.title.toLowerCase().indexOf(q) > -1; });
  $('#suggest').classList.remove('open');
  if(!matches.length){ toast('No results found', '', 'warn'); return; }
  $('#recGrid').innerHTML = matches.map(function(p){ return productCardHTML(p, true); }).join('');
  $('#recGrid').previousElementSibling.querySelector('.section-title').textContent = 'Results for "'+searchInput.value+'" — ' + matches.length + ' items';
  $('#recGrid').scrollIntoView({behavior:'smooth', block:'center'});
  toast(matches.length + ' results found');
});
document.addEventListener('click', function(e){
  if(!e.target.closest('.search-wrap')){ var s = $('#suggest'); if(s) s.classList.remove('open'); }
});

$('#sellLink').addEventListener('click', function(e){
  e.preventDefault();
  if(currentUser && currentUser.role === 'seller'){ openDashboard(); }
  else openAuth('seller');
});

function updateRailButtons(){
  $$('.rail').forEach(function(rail){
    var prev = document.querySelector('.rail-btn[data-rail="'+rail.id+'"][data-dir="-1"]');
    var next = document.querySelector('.rail-btn[data-rail="'+rail.id+'"][data-dir="1"]');
    if(!prev || !next) return;
    var atStart = rail.scrollLeft <= 4;
    var atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    prev.disabled = atStart; next.disabled = atEnd;
  });
}
document.addEventListener('scroll', updateRailButtons, true);
window.addEventListener('resize', updateRailButtons);

function scrollTop(e){ if(e) e.preventDefault(); window.scrollTo({top:0, behavior:'smooth'}); }

