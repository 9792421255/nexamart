</script>

<script>
/* =========================================================
   AUTH SAFETY NET — capture-phase fallback
   Ensures login works even if any main handler misbinds.
   ========================================================= */
(function(){
  'use strict';
  var DEMO = {
    'alex@example.com':    {password:'customer123', name:'Alex Morgan',    role:'customer'},
    'seller@nexamart.com': {password:'seller123',   name:'NovaTech Store', role:'seller'},
    'admin@nexamart.com':  {password:'admin123',    name:'Sarah Chen',     role:'admin'}
  };

  function ensureAuthOpen(role){
    var modal = document.getElementById('authModal');
    if(!modal) return;
    if(modal.classList.contains('open')) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    // Highlight role tab
    document.querySelectorAll('.role-tab').forEach(function(t){
      t.classList.toggle('active', t.dataset.role === (role||'customer'));
    });
  }

  function doLogin(email, password){
    var user = DEMO[email];
    if(!user || user.password !== password){
      return {ok:false, msg:'Invalid email or password'};
    }
    var newUser = {email:email, name:user.name, role:user.role};
    try { localStorage.setItem('nexamart_user', JSON.stringify(newUser)); } catch(e){}
    // Update global if possible
    try { window.currentUser = newUser; } catch(e){}
    try { if(typeof currentUser !== 'undefined') currentUser = newUser; } catch(e){}
    // Call the main script's renderer if available
    try {
      if(typeof renderAccountArea === 'function'){ renderAccountArea(); }
      else { rebuildAccount(newUser); }
    } catch(e){ rebuildAccount(newUser); }
    // Close modal
    var modal = document.getElementById('authModal');
    if(modal) modal.classList.remove('open');
    document.body.style.overflow = '';
    try { if(typeof toast === 'function') toast('Welcome, ' + newUser.name.split(' ')[0] + '!'); } catch(e){}
    // Auto-open dashboard for seller/admin
    if(newUser.role === 'seller' || newUser.role === 'admin'){
      setTimeout(function(){
        try { if(typeof openDashboard === 'function') openDashboard(); } catch(e){}
      }, 400);
    }
    return {ok:true};
  }

  function rebuildAccount(user){
    var el = document.getElementById('accountArea');
    if(!el) return;
    var role = user.role;
    var roleLabel = role.charAt(0).toUpperCase() + role.slice(1);
    var inits = user.name.split(' ').map(function(w){return w[0];}).join('').slice(0,2).toUpperCase();
    el.innerHTML = '<div class="h-box account" id="accountBox" style="position:relative">'+
      '<div class="h-label">Hello, '+user.name.split(' ')[0]+'</div>'+
      '<div class="h-strong">Account &amp; Lists <i class="chev"></i></div>'+
      '<div class="acct-menu" id="acctMenu">'+
        '<div class="acct-header"><div class="acct-avatar '+role+'">'+inits+'</div><div class="acct-info"><div class="acct-name">'+user.name+'</div><div class="acct-role '+role+'">'+roleLabel+'</div></div></div>'+
        '<button class="menu-item" id="dashBtnFallback"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>'+(role==='admin'?'Admin Dashboard':role==='seller'?'Seller Dashboard':'My Account')+'</button>'+
        '<div class="acct-divider"></div>'+
        '<button class="menu-item" id="logoutBtnFallback"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>Sign Out</button>'+
      '</div></div>';
    var box = document.getElementById('accountBox');
    if(box) box.addEventListener('click', function(e){
      if(e.target.closest('.acct-menu')) return;
      box.classList.toggle('open');
    });
    var db = document.getElementById('dashBtnFallback');
    if(db) db.addEventListener('click', function(){
      box.classList.remove('open');
      try { if(typeof openDashboard === 'function') openDashboard(); } catch(e){}
    });
    var lo = document.getElementById('logoutBtnFallback');
    if(lo) lo.addEventListener('click', function(){
      try { localStorage.removeItem('nexamart_user'); } catch(e){}
      try { window.currentUser = null; } catch(e){}
      try { if(typeof currentUser !== 'undefined') currentUser = null; } catch(e){}
      box.classList.remove('open');
      // Rebuild sign-in button
      var el2 = document.getElementById('accountArea');
      if(el2){
        el2.innerHTML = '<button class="auth-btn" id="loginBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Sign In</button>';
      }
      try { if(typeof toast === 'function') toast('Signed out'); } catch(e){}
    });
  }

  // Capture-phase click handler
  document.addEventListener('click', function(e){
    var loginBtn = e.target.closest('#loginBtn');
    if(loginBtn){ e.preventDefault(); e.stopPropagation(); ensureAuthOpen('customer'); return; }
    var authBtn = e.target.closest('.auth-btn');
    if(authBtn && !authBtn.closest('#authModal')){ e.preventDefault(); e.stopPropagation(); ensureAuthOpen('customer'); return; }
    var authLink = e.target.closest('[data-open-auth]');
    if(authLink){ e.preventDefault(); e.stopPropagation(); ensureAuthOpen(authLink.dataset.openAuth); return; }
    var demoRow = e.target.closest('.demo-row');
    if(demoRow && demoRow.closest('#authModal')){
      e.preventDefault(); e.stopPropagation();
      var role = demoRow.dataset.demo;
      var creds = {customer:['alex@example.com','customer123'],seller:['seller@nexamart.com','seller123'],admin:['admin@nexamart.com','admin123']}[role];
      var em = document.getElementById('authEmail');
      var pw = document.getElementById('authPassword');
      if(em) em.value = creds[0];
      if(pw) pw.value = creds[1];
      document.querySelectorAll('.role-tab').forEach(function(t){ t.classList.toggle('active', t.dataset.role===role); });
      try { if(typeof toast === 'function') toast('Filled '+role+' credentials'); } catch(ex){}
      return;
    }
    var roleTab = e.target.closest('.role-tab');
    if(roleTab && roleTab.closest('#authModal')){
      e.preventDefault(); e.stopPropagation();
      document.querySelectorAll('.role-tab').forEach(function(t){ t.classList.toggle('active', t===roleTab); });
      return;
    }
  }, true);

  // Capture-phase submit handler
  document.addEventListener('submit', function(e){
    if(e.target && e.target.id === 'authForm'){
      e.preventDefault();
      var email = (document.getElementById('authEmail').value || '').trim().toLowerCase();
      var password = document.getElementById('authPassword').value || '';
      if(!email){ alert('Please enter your email'); return; }
      if(!password){ alert('Please enter your password'); return; }
      var res = doLogin(email, password);
      if(!res.ok){
        // Show error toast
        try { if(typeof toast === 'function') toast(res.msg, '', 'error'); } catch(ex){ alert(res.msg); }
      }
    }
  }, true);

  // Restore session on load
  setTimeout(function(){
    try {
      var saved = localStorage.getItem('nexamart_user');
      if(saved){
        var u = JSON.parse(saved);
        var area = document.getElementById('accountArea');
        if(area && !area.querySelector('#accountBox')){
          try { if(typeof renderAccountArea === 'function') renderAccountArea(); else rebuildAccount(u); }
          catch(e){ rebuildAccount(u); }
        }
      }
    } catch(e){}
  }, 600);

  console.log('%c[NexaMart] Auth safety net active ✓', 'color:#0a0;font-weight:bold');
})();
</script>

