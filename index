function goSlide(i){
  var slides = $$('.hero-slide'), dots = $$('.dot');
  if(!slides.length) return;
  slideIndex = (i + slides.length) % slides.length;
  slides.forEach(function(s,k){ s.classList.toggle('active', k===slideIndex); });
  dots.forEach(function(d,k){ d.classList.toggle('active', k===slideIndex); });
}
function slideMove(dir){ goSlide(slideIndex + dir); restartSlides(); }
function startSlides(){ clearInterval(slideTimer); slideTimer = setInterval(function(){ goSlide(slideIndex + 1); }, 6000); }
function restartSlides(){ startSlides(); }

